# Copy to .env and fill in. `npm run demo` needs none of this.

NODE_ENV=production
PORT=3000
DATABASE_FILE=data/client-health.db

# Where clients open their survey links.
PUBLIC_URL=https://health.example.com
COMPANY_NAME=Example IT
TIMEZONE=America/Boise

# Surveys go out daily at this local hour to clients whose next date has arrived.
SURVEY_SEND_HOUR=9
SURVEY_TTL_DAYS=30

# Contract health. Unlimited contracts earning less than this per hour worked are flagged.
TARGET_HOURLY_RATE=125
# Block-hour contracts at or above this percent used are flagged "watch".
WATCH_PERCENT=85

# Sign-in through your identity provider (Okta, Entra ID, Google, Auth0...).
# Register a single-page app with the authorization code + PKCE flow,
# redirect URI = PUBLIC_URL/, and an API audience for this app.
AUTH_MODE=oidc
OIDC_ISSUER=https://your-org.okta.com/oauth2/default
OIDC_AUDIENCE=api://client-health
OIDC_CLIENT_ID=your-spa-client-id
# Claim that lists the user's groups, and the group allowed to send surveys and sync.
ROLES_CLAIM=groups
ADMIN_ROLE=client-health-admins

# Outbound mail. smtps://user:password@host:465 (keep this file out of git).
MAIL_MODE=smtp
SMTP_URL=
MAIL_FROM=Example IT <support@example.com>
